# Base de datos (PostgreSQL)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=registro_coyhaique
PG_USER=postgres
PG_PASSWORD=TU_CONTRASEÑA

# Autenticación — genera un secreto en: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET="pega_aqui_el_secreto_generado"
# Sandbox local: usar HTTPS (Cerofilas registra https://localhost:3000) y arrancar con npm run dev:https
NEXTAUTH_URL="https://localhost:3000"

# ClaveÚnica (Sandbox / QA / Producción según ambiente)
CLAVEUNICA_CLIENT_ID="tu_client_id_sandbox"
CLAVEUNICA_CLIENT_SECRET="tu_client_secret_sandbox"
# Opcional: forzar la Redirect URI si difiere de NEXTAUTH_URL + /api/auth/callback/claveunica
# CLAVEUNICA_REDIRECT_URI="https://localhost:3000/api/auth/callback/claveunica"
# Debe coincidir exactamente con Cerofilas (http/https, dominio y path):
# Sandbox: https://localhost:3000/api/auth/callback/claveunica
# QA:      https://registro-qa.municoyhaique.gob.cl/api/auth/callback/claveunica
CLAVEUNICA_LOGOUT_REDIRECT="https://localhost:3000"
# Mismo valor que CLAVEUNICA_LOGOUT_REDIRECT, expuesto al navegador para logout
NEXT_PUBLIC_CLAVEUNICA_LOGOUT_REDIRECT="https://localhost:3000"

# Correo saliente (SMTP — Outlook / Microsoft 365)
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_AUTH=true
SMTP_USER=registrorg@coyhaique.cl
SMTP_PASS=TU_CONTRASEÑA_SMTP
