# ============================================================
# CONFIGURACIÓN DE LA BASE DE DATOS
# ============================================================
# Reemplaza con los datos reales de tu PostgreSQL
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@localhost:5432/registro_coyhaique"

# DIRECT_URL es necesario si usas pooler de conexiones (Supabase, PgBouncer, etc.)
# Si usas PostgreSQL local directo, copia el mismo valor de DATABASE_URL
DIRECT_URL="postgresql://USUARIO:CONTRASEÑA@localhost:5432/registro_coyhaique"

# ============================================================
# CONFIGURACIÓN DE AUTENTICACIÓN (NextAuth)
# ============================================================
# Genera un secreto en: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET="REEMPLAZAR_CON_UN_SECRETO_ALEATORIO"

# URL pública del servidor (sin barra final)
# Desarrollo: http://localhost:3000
# Producción: https://tu-dominio.cl
NEXTAUTH_URL="http://localhost:3000"

# ============================================================
# CONFIGURACIÓN DE CORREO SMTP
# ============================================================
# Servidor de correo saliente para notificaciones automáticas
# Ejemplos:
#   Gmail:    smtp.gmail.com  puerto 587  secure=false
#   Outlook:  smtp.office365.com  puerto 587  secure=false
#   Con SSL:  smtp.ejemplo.cl  puerto 465  secure=true
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="correo@municipalidadcoyhaique.cl"
SMTP_PASS="CONTRASEÑA_O_APP_PASSWORD"
