# ============================================
# CONFIGURACIÓN DE LA BASE DE DATOS
# ============================================
# Reemplaza con los datos de tu PostgreSQL
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@localhost:5432/registro_coyhaique"

# ============================================
# CONFIGURACIÓN DE AUTENTICACIÓN (NextAuth)
# ============================================
# Genera uno en: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET="REEMPLAZAR_CON_UN_SECRETO_ALEATORIO"
NEXTAUTH_URL="http://localhost:3000"

# ============================================
# CONFIGURACIÓN DE ARCHIVOS
# ============================================
# Carpeta donde se guardarán los documentos subidos
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE=10485760  # 10 MB en bytes
